<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic but realistic Elasticity 2.0 example: "CloudNativeShop".
  Profile narrative: AllowMixedTargets (infra + service + competing consumers).
  Visualised by docs/CloudNativeShop-graph.html
-->
<elasticity:ElasticityViewpoint xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:elasticity="http://palladiosimulator.org/Elasticity/2.0"
    xmlns:scalable="http://palladiosimulator.org/Elasticity/Scalable/2.0"
    xmlns:policies="http://palladiosimulator.org/Elasticity/Policies/2.0"
    xmlns:reactive="http://palladiosimulator.org/Elasticity/Reactive/2.0"
    xmlns:observations="http://palladiosimulator.org/Elasticity/Observations/2.0"
    xmlns:actions="http://palladiosimulator.org/Elasticity/Actions/2.0"
    xmlns:learning="http://palladiosimulator.org/Elasticity/Learning/2.0"
    xmlns:elconstraints="http://palladiosimulator.org/Elasticity/Constraints/2.0"
    xsi:schemaLocation="http://palladiosimulator.org/Elasticity/2.0 ../../model/Elasticity.ecore"
    id="_ev_shop" entityName="CloudNativeShop">

  <scalableArchitecture id="_sa_shop" entityName="ShopScalableArchitecture">

    <!-- 1. App tier VMs (classic ASG) -->
    <groups id="_tg_app_asg" entityName="AppServerASG" cardinalitySemantics="INFRASTRUCTURE_POOL">
      <binding xsi:type="scalable:ResourceContainerTemplateBinding"
          unitResourceContainerRef="shop.resourceenvironment#_rc_app_template"
          resourceEnvironmentRef="shop.resourceenvironment"/>
      <enactmentHints xsi:type="scalable:LinkingResourceHint"
          linkingResourceRef="shop.resourceenvironment#_link_app_lan"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_app" entityName="appSize" minSize="2" maxSize="12"/>
      <groupConstraints xsi:type="elconstraints:ThrashingConstraint"
          id="_th_app" entityName="appAntiThrash" minimumTimeNoThrashing="120.0"/>
    </groups>

    <!-- 2. Cache / Redis-like hosts -->
    <groups id="_tg_cache" entityName="CacheCluster" cardinalitySemantics="INFRASTRUCTURE_POOL">
      <binding xsi:type="scalable:ResourceContainerTemplateBinding"
          unitResourceContainerRef="shop.resourceenvironment#_rc_cache_template"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_cache" entityName="cacheSize" minSize="1" maxSize="6"/>
    </groups>

    <!-- 3. Stateless storefront replicas behind LB -->
    <groups id="_tg_web" entityName="WebFrontend" cardinalitySemantics="HOMOGENEOUS_REPLICA">
      <binding xsi:type="scalable:AssemblyReplicaBinding"
          unitAssemblyRef="shop.system#_assembly_web"/>
      <enactmentHints xsi:type="scalable:LoadBalancerHint"
          loadBalancingAssemblyRef="shop.system#_assembly_web_lb"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_web" entityName="webSize" minSize="2" maxSize="20"/>
    </groups>

    <!-- 4. Payment service (sensitive SLO) -->
    <groups id="_tg_pay" entityName="PaymentService" cardinalitySemantics="HOMOGENEOUS_REPLICA">
      <binding xsi:type="scalable:AssemblyReplicaBinding"
          unitAssemblyRef="shop.system#_assembly_payment"/>
      <enactmentHints xsi:type="scalable:LoadBalancerHint"
          loadBalancingAssemblyRef="shop.system#_assembly_payment_lb"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_pay" entityName="paySize" minSize="2" maxSize="10"/>
      <groupConstraints xsi:type="elconstraints:ThrashingConstraint"
          id="_th_pay" entityName="payAntiThrash" minimumTimeNoThrashing="180.0"/>
    </groups>

    <!-- 5. Catalog browse service -->
    <groups id="_tg_catalog" entityName="CatalogService" cardinalitySemantics="HOMOGENEOUS_REPLICA">
      <binding xsi:type="scalable:AssemblyReplicaBinding"
          unitAssemblyRef="shop.system#_assembly_catalog"/>
      <enactmentHints xsi:type="scalable:LoadBalancerHint"
          loadBalancingAssemblyRef="shop.system#_assembly_catalog_lb"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_cat" entityName="catalogSize" minSize="1" maxSize="16"/>
    </groups>

    <!-- 6. Async order workers (competing consumers) -->
    <groups id="_tg_orders" entityName="OrderWorkers" cardinalitySemantics="CONSUMER_POOL">
      <binding xsi:type="scalable:CompetingConsumerBinding"
          unitAssemblyRef="shop.system#_assembly_order_worker"
          passiveResourceQueueRef="shop.repository#_pr_order_queue"
          usageScenarioRef="shop.usagemodel#_us_order_drain"/>
      <enactmentHints xsi:type="scalable:BrokerHint"
          brokerAssemblyRef="shop.system#_assembly_order_broker"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_ord" entityName="workerSize" minSize="1" maxSize="24"/>
    </groups>

    <!-- 7. Notification email workers -->
    <groups id="_tg_notify" entityName="NotificationWorkers" cardinalitySemantics="CONSUMER_POOL">
      <binding xsi:type="scalable:CompetingConsumerBinding"
          unitAssemblyRef="shop.system#_assembly_notify_worker"
          passiveResourceQueueRef="shop.repository#_pr_notify_queue"
          usageScenarioRef="shop.usagemodel#_us_notify_drain"/>
      <enactmentHints xsi:type="scalable:BrokerHint"
          brokerAssemblyRef="shop.system#_assembly_notify_broker"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_ntf" entityName="notifySize" minSize="1" maxSize="8"/>
    </groups>
  </scalableArchitecture>

  <policySet id="_ps_shop" entityName="ShopPolicies">

    <!-- App ASG: reactive CPU scale-out -->
    <policies id="_pol_app_out" entityName="AppCpuScaleOut" active="true"
        target="//@scalableArchitecture/@groups.0">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="MAX"/>
          <expected xsi:type="reactive:ExpectedPercentage" value="75.0"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="1"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_app_out" entityName="appOutCooldown" cooldownTime="90.0" maxScalingOperations="1"/>
    </policies>

    <!-- App ASG: reactive CPU scale-in -->
    <policies id="_pol_app_in" entityName="AppCpuScaleIn" active="true"
        target="//@scalableArchitecture/@groups.0">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="LessThan">
          <observation metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="AVERAGE"/>
          <expected xsi:type="reactive:ExpectedPercentage" value="25.0"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="-1"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_app_in" entityName="appInCooldown" cooldownTime="180.0" maxScalingOperations="1"/>
    </policies>

    <!-- Cache: scheduled night shrink -->
    <policies id="_pol_cache_night" entityName="CacheNightShrink" active="true"
        target="//@scalableArchitecture/@groups.1">
      <decision xsi:type="policies:ScheduledProcedure" interval="3600.0" offset="0.0">
        <effect xsi:type="actions:AbsoluteAction" goalValue="1"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:IntervalConstraint"
          id="_iv_cache" entityName="nightWindow" offset="79200.0" intervalDuration="21600.0" repeat="true"/>
    </policies>

    <!-- Cache: reactive memory pressure -->
    <policies id="_pol_cache_mem" entityName="CacheMemoryScaleOut" active="true"
        target="//@scalableArchitecture/@groups.1">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="MEMORY_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="AVERAGE"/>
          <expected xsi:type="reactive:ExpectedPercentage" value="85.0"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="1"/>
      </decision>
    </policies>

    <!-- Web: relative scale-out on response time -->
    <policies id="_pol_web_rt" entityName="WebResponseTimeScaleOut" active="true"
        target="//@scalableArchitecture/@groups.2">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="OPERATION_RESPONSE_TIME" scope="PCM_ELEMENT" aggregation="AVERAGE"
              pcmElementRef="shop.repository#_op_browseHome"/>
          <expected xsi:type="reactive:ExpectedTime" value="0.8"/>
        </trigger>
        <effect xsi:type="actions:RelativeAction" percentageGrowthValue="50" minAdjustmentValue="1"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_web" entityName="webCooldown" cooldownTime="60.0" maxScalingOperations="2"/>
    </policies>

    <!-- Web: composed trigger (CPU high OR task count high) -->
    <policies id="_pol_web_composed" entityName="WebLoadComposedScaleOut" active="true"
        target="//@scalableArchitecture/@groups.2">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComposedTrigger" logicalOperator="OR">
          <operands xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
            <observation metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="AVERAGE"/>
            <expected xsi:type="reactive:ExpectedPercentage" value="70.0"/>
          </operands>
          <operands xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
            <observation metric="TASK_COUNT" scope="TARGET_GROUP_AGGREGATE" aggregation="SUM"/>
            <expected xsi:type="reactive:ExpectedCount" count="200"/>
          </operands>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="2"/>
      </decision>
    </policies>

    <!-- Payment: Fuzzy Q-Learning -->
    <policies id="_pol_pay_rl" entityName="PaymentFuzzyQLearning" active="true"
        target="//@scalableArchitecture/@groups.3">
      <decision xsi:type="policies:LearningProcedure" interval="30.0" intervalOffset="5.0">
        <observations metric="OPERATION_RESPONSE_TIME" scope="PCM_ELEMENT" aggregation="AVERAGE"
            pcmElementRef="shop.repository#_op_authorizePayment"/>
        <observations metric="NUMBER_OF_ELEMENTS" scope="TARGET_GROUP_AGGREGATE"/>
        <observations metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="AVERAGE"/>
        <actionSpace xsi:type="actions:DiscreteStepActionSpace" minDelta="-2" maxDelta="2"/>
        <reward xsi:type="learning:ResponseTimeTargetReward" targetResponseTime="0.35"
            operationSignatureRef="shop.repository#_op_authorizePayment" aggregation="AVERAGE"/>
        <hyperParameters learningRate="0.65" discountFactor="0.55" epsilon="0.08" initialization="OPTIMISTIC"/>
        <algorithm xsi:type="learning:FuzzyQLearning"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_pay" entityName="payLearnCooldown" cooldownTime="45.0" maxScalingOperations="1"/>
    </policies>

    <!-- Catalog: Fuzzy SARSA -->
    <policies id="_pol_cat_sarsa" entityName="CatalogFuzzySARSA" active="true"
        target="//@scalableArchitecture/@groups.4">
      <decision xsi:type="policies:LearningProcedure" interval="45.0" intervalOffset="0.0">
        <observations metric="OPERATION_RESPONSE_TIME" scope="PCM_ELEMENT" aggregation="MEDIAN"
            pcmElementRef="shop.repository#_op_searchCatalog"/>
        <observations metric="NUMBER_OF_ELEMENTS" scope="TARGET_GROUP_AGGREGATE"/>
        <actionSpace xsi:type="actions:DiscreteStepActionSpace" minDelta="-1" maxDelta="3"/>
        <reward xsi:type="learning:WeightedMultiObjectiveReward"
            sloWeight="1.0" costWeight="0.35" oscillationPenaltyWeight="0.2" targetResponseTime="0.6"/>
        <hyperParameters learningRate="0.5" discountFactor="0.7" epsilon="0.05" initialization="KNOWLEDGE"/>
        <algorithm xsi:type="learning:FuzzySARSA"/>
      </decision>
    </policies>

    <!-- Order workers: queue length reactive -->
    <policies id="_pol_ord_q" entityName="OrderQueueScaleOut" active="true"
        target="//@scalableArchitecture/@groups.5">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="QUEUE_LENGTH" scope="PCM_ELEMENT" aggregation="MAX"
              pcmElementRef="shop.repository#_pr_order_queue"/>
          <expected xsi:type="reactive:ExpectedCount" count="50"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="2"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_ord" entityName="orderCooldown" cooldownTime="30.0" maxScalingOperations="2"/>
    </policies>

    <!-- Order workers: scale-in when queue drains -->
    <policies id="_pol_ord_in" entityName="OrderQueueScaleIn" active="true"
        target="//@scalableArchitecture/@groups.5">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="LessThan">
          <observation metric="QUEUE_LENGTH" scope="PCM_ELEMENT" aggregation="AVERAGE"
              pcmElementRef="shop.repository#_pr_order_queue"/>
          <expected xsi:type="reactive:ExpectedCount" count="5"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="-1"/>
      </decision>
    </policies>

    <!-- Notification workers: scheduled business-hours boost -->
    <policies id="_pol_ntf_biz" entityName="NotifyBusinessHoursFloor" active="true"
        target="//@scalableArchitecture/@groups.6">
      <decision xsi:type="policies:ScheduledProcedure" interval="900.0" offset="100.0">
        <effect xsi:type="actions:AbsoluteAction" goalValue="3"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:IntervalConstraint"
          id="_iv_ntf" entityName="businessHours" offset="28800.0" intervalDuration="36000.0" repeat="true"/>
    </policies>

    <!-- Notification: reactive queue -->
    <policies id="_pol_ntf_q" entityName="NotifyQueueScaleOut" active="true"
        target="//@scalableArchitecture/@groups.6">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="QUEUE_LENGTH" scope="PCM_ELEMENT"
              pcmElementRef="shop.repository#_pr_notify_queue"/>
          <expected xsi:type="reactive:ExpectedCount" count="20"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="1"/>
      </decision>
    </policies>
  </policySet>
</elasticity:ElasticityViewpoint>
