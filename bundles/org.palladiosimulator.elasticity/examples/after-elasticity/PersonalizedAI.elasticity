<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic Elasticity 2.0 example: "PersonalizedAI" (PersonaRAG).
  Domain: personalised assistant platform — LLM serving, RAG retrieval/rerank,
  vector index hosts, async memory ingest & corpus embedding workers.
  Profile: AllowMixedTargets (GPU infra + service replicas + competing consumers).
  Visualised by docs/PersonalizedAI-graph.html
-->
<elasticity:ElasticityViewpoint xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:elasticity="http://palladiosimulator.org/Elasticity/2.0"
    xmlns:scalable="http://palladiosimulator.org/Elasticity/Scalable/2.0"
    xmlns:policies="http://palladiosimulator.org/Elasticity/Policies/2.0"
    xmlns:reactive="http://palladiosimulator.org/Elasticity/Reactive/2.0"
    xmlns:observations="http://palladiosimulator.org/Elasticity/Observations/2.0"
    xmlns:actions="http://palladiosimulator.org/Elasticity/Actions/2.0"
    xmlns:learning="http://palladiosimulator.org/Elasticity/Learning/2.0"
    xmlns:elconstraints="http://palladiosimulator.org/Elasticity/Constraints/2.0"
    xsi:schemaLocation="http://palladiosimulator.org/Elasticity/2.0 ../../model/Elasticity.ecore"
    id="_ev_pai" entityName="PersonalizedAI">

  <scalableArchitecture id="_sa_pai" entityName="PersonaRAGArchitecture">

    <!-- 1. GPU inference hosts (vLLM / TGI style ASG) -->
    <groups id="_tg_gpu" entityName="GpuInferenceASG" cardinalitySemantics="INFRASTRUCTURE_POOL">
      <binding xsi:type="scalable:ResourceContainerTemplateBinding"
          unitResourceContainerRef="pai.resourceenvironment#_rc_gpu_template"
          resourceEnvironmentRef="pai.resourceenvironment"/>
      <enactmentHints xsi:type="scalable:LinkingResourceHint"
          linkingResourceRef="pai.resourceenvironment#_link_gpu_fabric"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_gpu" entityName="gpuSize" minSize="1" maxSize="16"/>
      <groupConstraints xsi:type="elconstraints:ThrashingConstraint"
          id="_th_gpu" entityName="gpuAntiThrash" minimumTimeNoThrashing="180.0"/>
    </groups>

    <!-- 2. Vector / ANN index hosts (HNSW / IVF store) -->
    <groups id="_tg_vector" entityName="VectorIndexCluster" cardinalitySemantics="INFRASTRUCTURE_POOL">
      <binding xsi:type="scalable:ResourceContainerTemplateBinding"
          unitResourceContainerRef="pai.resourceenvironment#_rc_vector_template"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_vec" entityName="vectorSize" minSize="2" maxSize="10"/>
    </groups>

    <!-- 3. LLM API gateway / router replicas -->
    <groups id="_tg_gateway" entityName="LlmGateway" cardinalitySemantics="HOMOGENEOUS_REPLICA">
      <binding xsi:type="scalable:AssemblyReplicaBinding"
          unitAssemblyRef="pai.system#_assembly_llm_gateway"/>
      <enactmentHints xsi:type="scalable:LoadBalancerHint"
          loadBalancingAssemblyRef="pai.system#_assembly_gateway_lb"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_gw" entityName="gatewaySize" minSize="2" maxSize="24"/>
    </groups>

    <!-- 4. RAG retriever (top-k search over personal + corpus indexes) -->
    <groups id="_tg_retriever" entityName="RagRetriever" cardinalitySemantics="HOMOGENEOUS_REPLICA">
      <binding xsi:type="scalable:AssemblyReplicaBinding"
          unitAssemblyRef="pai.system#_assembly_rag_retriever"/>
      <enactmentHints xsi:type="scalable:LoadBalancerHint"
          loadBalancingAssemblyRef="pai.system#_assembly_retriever_lb"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_ret" entityName="retrieverSize" minSize="2" maxSize="20"/>
      <groupConstraints xsi:type="elconstraints:ThrashingConstraint"
          id="_th_ret" entityName="retrieverAntiThrash" minimumTimeNoThrashing="120.0"/>
    </groups>

    <!-- 5. Cross-encoder / LLM reranker -->
    <groups id="_tg_rerank" entityName="RerankerService" cardinalitySemantics="HOMOGENEOUS_REPLICA">
      <binding xsi:type="scalable:AssemblyReplicaBinding"
          unitAssemblyRef="pai.system#_assembly_reranker"/>
      <enactmentHints xsi:type="scalable:LoadBalancerHint"
          loadBalancingAssemblyRef="pai.system#_assembly_reranker_lb"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_rr" entityName="rerankSize" minSize="1" maxSize="12"/>
    </groups>

    <!-- 6. Personal memory ingest (competing consumers on user-event queue) -->
    <groups id="_tg_memory" entityName="MemoryIngestWorkers" cardinalitySemantics="CONSUMER_POOL">
      <binding xsi:type="scalable:CompetingConsumerBinding"
          unitAssemblyRef="pai.system#_assembly_memory_worker"
          passiveResourceQueueRef="pai.repository#_pr_memory_queue"
          usageScenarioRef="pai.usagemodel#_us_memory_drain"/>
      <enactmentHints xsi:type="scalable:BrokerHint"
          brokerAssemblyRef="pai.system#_assembly_memory_broker"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_mem" entityName="memoryWorkerSize" minSize="1" maxSize="32"/>
    </groups>

    <!-- 7. Corpus embedding / chunk-index workers -->
    <groups id="_tg_embed" entityName="EmbeddingIndexWorkers" cardinalitySemantics="CONSUMER_POOL">
      <binding xsi:type="scalable:CompetingConsumerBinding"
          unitAssemblyRef="pai.system#_assembly_embed_worker"
          passiveResourceQueueRef="pai.repository#_pr_embed_queue"
          usageScenarioRef="pai.usagemodel#_us_embed_drain"/>
      <enactmentHints xsi:type="scalable:BrokerHint"
          brokerAssemblyRef="pai.system#_assembly_embed_broker"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz_emb" entityName="embedWorkerSize" minSize="1" maxSize="40"/>
    </groups>
  </scalableArchitecture>

  <policySet id="_ps_pai" entityName="PersonaRAGPolicies">

    <!-- GPU ASG: reactive utilisation scale-out -->
    <policies id="_pol_gpu_out" entityName="GpuUtilScaleOut" active="true"
        target="//@scalableArchitecture/@groups.0">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="MAX"/>
          <expected xsi:type="reactive:ExpectedPercentage" value="80.0"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="1"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_gpu_out" entityName="gpuOutCooldown" cooldownTime="120.0" maxScalingOperations="1"/>
    </policies>

    <!-- GPU ASG: scale-in when fabric cool -->
    <policies id="_pol_gpu_in" entityName="GpuUtilScaleIn" active="true"
        target="//@scalableArchitecture/@groups.0">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="LessThan">
          <observation metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="AVERAGE"/>
          <expected xsi:type="reactive:ExpectedPercentage" value="30.0"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="-1"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_gpu_in" entityName="gpuInCooldown" cooldownTime="300.0" maxScalingOperations="1"/>
    </policies>

    <!-- Vector cluster: scheduled off-peak shrink -->
    <policies id="_pol_vec_night" entityName="VectorOffPeakShrink" active="true"
        target="//@scalableArchitecture/@groups.1">
      <decision xsi:type="policies:ScheduledProcedure" interval="3600.0" offset="0.0">
        <effect xsi:type="actions:AbsoluteAction" goalValue="2"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:IntervalConstraint"
          id="_iv_vec" entityName="offPeakWindow" offset="79200.0" intervalDuration="21600.0" repeat="true"/>
    </policies>

    <!-- Vector: reactive memory pressure (index residency) -->
    <policies id="_pol_vec_mem" entityName="VectorMemoryScaleOut" active="true"
        target="//@scalableArchitecture/@groups.1">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="MEMORY_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="AVERAGE"/>
          <expected xsi:type="reactive:ExpectedPercentage" value="88.0"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="1"/>
      </decision>
    </policies>

    <!-- Gateway: time-to-first-token / chat RT -->
    <policies id="_pol_gw_ttft" entityName="GatewayTtftScaleOut" active="true"
        target="//@scalableArchitecture/@groups.2">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="OPERATION_RESPONSE_TIME" scope="PCM_ELEMENT" aggregation="AVERAGE"
              pcmElementRef="pai.repository#_op_chatCompletion"/>
          <expected xsi:type="reactive:ExpectedTime" value="1.2"/>
        </trigger>
        <effect xsi:type="actions:RelativeAction" percentageGrowthValue="40" minAdjustmentValue="1"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_gw" entityName="gatewayCooldown" cooldownTime="45.0" maxScalingOperations="2"/>
    </policies>

    <!-- Gateway: composed (queueing OR util) -->
    <policies id="_pol_gw_composed" entityName="GatewayLoadComposedScaleOut" active="true"
        target="//@scalableArchitecture/@groups.2">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComposedTrigger" logicalOperator="OR">
          <operands xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
            <observation metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="AVERAGE"/>
            <expected xsi:type="reactive:ExpectedPercentage" value="70.0"/>
          </operands>
          <operands xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
            <observation metric="TASK_COUNT" scope="TARGET_GROUP_AGGREGATE" aggregation="SUM"/>
            <expected xsi:type="reactive:ExpectedCount" count="150"/>
          </operands>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="2"/>
      </decision>
    </policies>

    <!-- Retriever: Fuzzy Q-Learning on personalised retrieve latency -->
    <policies id="_pol_ret_rl" entityName="RetrieverFuzzyQLearning" active="true"
        target="//@scalableArchitecture/@groups.3">
      <decision xsi:type="policies:LearningProcedure" interval="25.0" intervalOffset="3.0">
        <observations metric="OPERATION_RESPONSE_TIME" scope="PCM_ELEMENT" aggregation="AVERAGE"
            pcmElementRef="pai.repository#_op_retrieveContext"/>
        <observations metric="NUMBER_OF_ELEMENTS" scope="TARGET_GROUP_AGGREGATE"/>
        <observations metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="AVERAGE"/>
        <actionSpace xsi:type="actions:DiscreteStepActionSpace" minDelta="-2" maxDelta="3"/>
        <reward xsi:type="learning:ResponseTimeTargetReward" targetResponseTime="0.25"
            operationSignatureRef="pai.repository#_op_retrieveContext" aggregation="AVERAGE"/>
        <hyperParameters learningRate="0.6" discountFactor="0.55" epsilon="0.07" initialization="OPTIMISTIC"/>
        <algorithm xsi:type="learning:FuzzyQLearning"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_ret" entityName="retrieverLearnCooldown" cooldownTime="40.0" maxScalingOperations="1"/>
    </policies>

    <!-- Reranker: Fuzzy SARSA (cost-sensitive) -->
    <policies id="_pol_rr_sarsa" entityName="RerankerFuzzySARSA" active="true"
        target="//@scalableArchitecture/@groups.4">
      <decision xsi:type="policies:LearningProcedure" interval="40.0" intervalOffset="0.0">
        <observations metric="OPERATION_RESPONSE_TIME" scope="PCM_ELEMENT" aggregation="MEDIAN"
            pcmElementRef="pai.repository#_op_rerankPassages"/>
        <observations metric="NUMBER_OF_ELEMENTS" scope="TARGET_GROUP_AGGREGATE"/>
        <actionSpace xsi:type="actions:DiscreteStepActionSpace" minDelta="-1" maxDelta="2"/>
        <reward xsi:type="learning:WeightedMultiObjectiveReward"
            sloWeight="1.0" costWeight="0.45" oscillationPenaltyWeight="0.25" targetResponseTime="0.4"/>
        <hyperParameters learningRate="0.5" discountFactor="0.65" epsilon="0.06" initialization="KNOWLEDGE"/>
        <algorithm xsi:type="learning:FuzzySARSA"/>
      </decision>
    </policies>

    <!-- Memory ingest: backlog scale-out -->
    <policies id="_pol_mem_q" entityName="MemoryQueueScaleOut" active="true"
        target="//@scalableArchitecture/@groups.5">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="QUEUE_LENGTH" scope="PCM_ELEMENT" aggregation="MAX"
              pcmElementRef="pai.repository#_pr_memory_queue"/>
          <expected xsi:type="reactive:ExpectedCount" count="80"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="3"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:CooldownConstraint"
          id="_cd_mem" entityName="memoryCooldown" cooldownTime="25.0" maxScalingOperations="2"/>
    </policies>

    <!-- Memory: scale-in when personalisation backlog drains -->
    <policies id="_pol_mem_in" entityName="MemoryQueueScaleIn" active="true"
        target="//@scalableArchitecture/@groups.5">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="LessThan">
          <observation metric="QUEUE_LENGTH" scope="PCM_ELEMENT" aggregation="AVERAGE"
              pcmElementRef="pai.repository#_pr_memory_queue"/>
          <expected xsi:type="reactive:ExpectedCount" count="8"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="-1"/>
      </decision>
    </policies>

    <!-- Embedding workers: scheduled corpus-rebuild floor -->
    <policies id="_pol_emb_rebuild" entityName="EmbedRebuildFloor" active="true"
        target="//@scalableArchitecture/@groups.6">
      <decision xsi:type="policies:ScheduledProcedure" interval="600.0" offset="50.0">
        <effect xsi:type="actions:AbsoluteAction" goalValue="6"/>
      </decision>
      <policyConstraints xsi:type="elconstraints:IntervalConstraint"
          id="_iv_emb" entityName="nightlyRebuild" offset="7200.0" intervalDuration="10800.0" repeat="true"/>
    </policies>

    <!-- Embedding: reactive queue during continuous ingest -->
    <policies id="_pol_emb_q" entityName="EmbedQueueScaleOut" active="true"
        target="//@scalableArchitecture/@groups.6">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="QUEUE_LENGTH" scope="PCM_ELEMENT"
              pcmElementRef="pai.repository#_pr_embed_queue"/>
          <expected xsi:type="reactive:ExpectedCount" count="100"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="2"/>
      </decision>
    </policies>
  </policySet>
</elasticity:ElasticityViewpoint>
