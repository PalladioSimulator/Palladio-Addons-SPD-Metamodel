<?xml version="1.0" encoding="UTF-8"?>
<!-- AFTER: same reactive infra policies expressed in Elasticity 2.0 -->
<elasticity:ElasticityViewpoint xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:elasticity="http://palladiosimulator.org/Elasticity/2.0"
    xmlns:scalable="http://palladiosimulator.org/Elasticity/Scalable/2.0"
    xmlns:policies="http://palladiosimulator.org/Elasticity/Policies/2.0"
    xmlns:reactive="http://palladiosimulator.org/Elasticity/Reactive/2.0"
    xmlns:observations="http://palladiosimulator.org/Elasticity/Observations/2.0"
    xmlns:actions="http://palladiosimulator.org/Elasticity/Actions/2.0"
    xmlns:elconstraints="http://palladiosimulator.org/Elasticity/Constraints/2.0"
    xsi:schemaLocation="http://palladiosimulator.org/Elasticity/2.0 ../model/Elasticity.ecore"
    id="_ev_infra" entityName="InfrastructureSPD">
  <scalableArchitecture id="_sa" entityName="ScalableArchitecture">
    <groups id="_tg_infra" entityName="AppASG" cardinalitySemantics="INFRASTRUCTURE_POOL">
      <binding xsi:type="scalable:ResourceContainerTemplateBinding"
          unitResourceContainerRef="default.resourceenvironment#_rc_app"/>
      <groupConstraints xsi:type="elconstraints:TargetGroupSizeConstraint"
          id="_sz" entityName="size" minSize="1" maxSize="10"/>
    </groups>
  </scalableArchitecture>
  <policySet id="_ps" entityName="Policies">
    <policies id="scaleOut" entityName="scaleOut" active="true" target="//@scalableArchitecture/@groups.0">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="GreaterThan">
          <observation metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="MAX"/>
          <expected xsi:type="reactive:ExpectedPercentage" value="80.0"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="1"/>
      </decision>
    </policies>
    <policies id="scaleIn" entityName="scaleIn" active="true" target="//@scalableArchitecture/@groups.0">
      <decision xsi:type="policies:ReactiveRuleProcedure">
        <trigger xsi:type="reactive:ComparisonTrigger" relationalOperator="LessThan">
          <observation metric="CPU_UTILIZATION" scope="TARGET_GROUP_AGGREGATE" aggregation="AVERAGE"/>
          <expected xsi:type="reactive:ExpectedPercentage" value="30.0"/>
        </trigger>
        <effect xsi:type="actions:StepAction" stepValue="-1"/>
      </decision>
    </policies>
  </policySet>
</elasticity:ElasticityViewpoint>
